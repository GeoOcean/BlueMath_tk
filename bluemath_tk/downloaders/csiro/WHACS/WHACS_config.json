{
    "description": "Wave Hindcast for the Australian Climate Service (WHACS), WAVEWATCH III v6.07 forced by ERA5",
    "fileserver_url": "https://data-cbr.csiro.au/thredds5/fileServer/catch_all/",
    "opendap_url": "https://data-cbr.csiro.au/thredds5/dodsC/catch_all/",
    "catalog_url": "https://data-cbr.csiro.au/thredds5/catalog/catch_all/",
    "datasets": {
        "global-smc": {
            "description": "Global SMC grid, hourly, one file per variable and month",
            "remote_dir": "ACS_WP3_WHACS/ACS_hindcast_DRS/gridded/release/WP3/WHACS/BoM-CSIRO/hindcast/ERA5/ERA5/WHACS/WWIII-v6.07/global-smc/1hr/{variable}/",
            "filename": "{variable}_WHACS_hindcast_WHACS_ERA5_1hr_{year}{month:02d}010000-{year}{month:02d}{last_day:02d}2300.nc",
            "local_dir": "WHACS/global-smc/{variable}",
            "start": "1979-01",
            "end": "2023-12",
            "file_per_variable": true,
            "point_dim": "seapoint",
            "variables": {
                "hs": "Significant wave height",
                "t01": "Mean wave period (m0/m1)",
                "t02": "Mean wave period (m0/m2)",
                "t0m1": "Mean wave period (m-1/m0)",
                "fp": "Peak frequency",
                "dir": "Mean wave direction",
                "dp": "Peak direction",
                "spr": "Directional spread",
                "cge": "Wave energy flux",
                "uwnd": "Eastward wind",
                "vwnd": "Northward wind",
                "phs0": "Partition 0 (wind sea) significant wave height",
                "phs1": "Partition 1 significant wave height",
                "phs2": "Partition 2 significant wave height",
                "phs3": "Partition 3 significant wave height",
                "ptp0": "Partition 0 (wind sea) peak period",
                "ptp1": "Partition 1 peak period",
                "ptp2": "Partition 2 peak period",
                "ptp3": "Partition 3 peak period",
                "pdir0": "Partition 0 (wind sea) mean direction",
                "pdir1": "Partition 1 mean direction",
                "pdir2": "Partition 2 mean direction",
                "pdir3": "Partition 3 mean direction",
                "pspr0": "Partition 0 (wind sea) directional spread",
                "pspr1": "Partition 1 directional spread",
                "pspr2": "Partition 2 directional spread",
                "pspr3": "Partition 3 directional spread",
                "pdp0": "Partition 0 (wind sea) peak direction",
                "pdp1": "Partition 1 peak direction",
                "pdp2": "Partition 2 peak direction",
                "pdp3": "Partition 3 peak direction",
                "ppe0": "Partition 0 (wind sea) peakedness",
                "ppe1": "Partition 1 peakedness",
                "ppe2": "Partition 2 peakedness",
                "ppe3": "Partition 3 peakedness",
                "pqp0": "Partition 0 (wind sea) Goda peakedness",
                "pqp1": "Partition 1 Goda peakedness",
                "pqp2": "Partition 2 Goda peakedness",
                "pqp3": "Partition 3 Goda peakedness"
            }
        }
    }
}
